<EOL>listprecedenceprecedence     | operators
---------------+----------
 1. Call       | . () [] postfix ++/-- postfix ! !! ~
 2. Unary      | ! - + ~ * & prefix !! ++/-- (cast)
 3. Mult       | * / %
 4. Shift      | << >>
 5. Bitwise    | ^ | &
 6. Or-else    | ?: ??
 7. Additive   | + - +++
 8. Relational | < > <= >= == !=
 9. And        | && &&&
10. Or         | || |||
11. Ternary    | ? ???
12. Assign     | = *= /= %= -= += |= &= ^= <<= >>= +++=recipeRecipe: append a line to a file (file::open with mode "a"), then read the file back// Also: append, add to file, log file, write lines, open for append, file::open, File.write
import std::io;
import std::io::file;

fn void? run(String path)
{
	File f = file::open(path, "a")!;
	defer (void)f.close();
	f.write("first\n")!;
	f.write("second\n")!;
}

fn void main()
{
	String path = "recipe_append.txt";
	defer (void)file::delete(path);
	if (catch run(path))
	{
		io::printn("write failed");
		return;
	}
	String text = (String)file::load_temp(path)!!;
	io::printfn("lines: %d", text.trim().tsplit("\n").len);
}recipes/append_file.c3recipeRecipe: command line arguments (main with String[] args)// Also: argv, argc, main arguments, command line parameters, program name
import std::io;

fn void main(String[] args)
{
	// args[0] is the program name
	io::printfn("args: %d", args.len - 1);
	foreach (i, a : args[1..]) io::printfn("%d: %s", i, a);
}recipes/args.c3recipeRecipe: an atomic counter (Atomic{int}: add, store, load) that threads can share without a mutex// Also: atomics, atomic add, fetch_add, lock free, counter, thread safe
import std::io;
import std::atomic;

fn void main()
{
	Atomic{int} counter;
	counter.store(5);
	counter.add(2);
	io::printfn("total=%d", counter.load());
}recipes/atomic_counter.c3recipeRecipe: bitstruct (named bit fields packed in an integer) and union (one storage, several views)// Also: flags, bit flags, bit field, bitmask, union, reinterpret
import std::io;

bitstruct Perm : char
{
	bool read : 0;
	bool write : 1;
	bool exec : 2;
}

union Number
{
	int as_int;
	float as_float;
}

fn void main()
{
	Perm p = { .read = true, .exec = true };
	io::printfn("read=%s write=%s", p.read, p.write);
	io::printfn("raw=%d", (char)p);
	Number n;
	n.as_int = 1;
	io::printfn("sizes: %d %d", Perm::size, Number::size);
}recipes/bitstruct_union.c3recipeRecipe: wall clock and stopwatch (time::now for the date, clock::now for measuring how long something takes)// Also: current time, timestamp, unix time, milliseconds, elapsed, stopwatch, benchmark, duration
import std::io;
import std::time;
import std::time::clock;
import std::thread;

fn void main()
{
	Time t = time::now();                           // wall clock, for dates
	io::printfn("after 2000: %s", t.to_seconds() > 946684800);
	Clock c = clock::now();                         // monotonic, for durations
	thread::sleep_ms(20);
	long ms = (long)c.to_now() / 1_000_000;         // nanoseconds to milliseconds
	io::printfn("elapsed ok: %s", ms >= 20);
}recipes/clock_time.c3recipeRecipe: calendar date: build a DateTime, weekday name, format a date, parts (year, month, day)// Also: std::time, datetime, day of week, calendar, Date, strftime, timestamp, now, TzDateTime
import std::io;
import std::time;
import std::time::datetime;

fn void main()
{
	DateTime d;
	d.set(2026, NOVEMBER, 1);               // there is no Date type: DateTime with year, month, day
	d = datetime::from_time(d.to_time());   // round trip through Time fills in weekday and yearday
	io::printfn("2026-11-01 is %s", d.weekday);     // an enum prints its constant name
	io::printfn("year=%d month=%d day=%d", d.year, (int)d.month + 1, d.day);
	// now: DateTime now = datetime::now();
}recipes/date_weekday.c3recipeRecipe: defer, @pool and the temporary allocator tmem (no free needed inside @pool)import std::io;

fn String build()
{
	@pool()
	{
		// tmem memory is released when the @pool block ends: copy what you return out of it
		String s = string::tformat("%s-%s-%s", "x", "y", "z");
		return s.copy(mem);
	};
}

fn void main()
{
	defer io::printn("cleanup");       // runs when main returns, last defer first
	io::printn("working");
	String s = build();
	defer s.free(mem);
	io::printfn("built: %s", s);
}recipes/defer_pool.c3recipeRecipe: number of enum values: Status::len, enum element count, size an array by enum, loop over all enum values, enum names// Also: enum length, count of constants, from_ordinal, Enum::names, EnumMap
import std::io;

enum Status { IDLE, ACTIVE, DONE }

fn void main()
{
	io::printfn("count=%d", Status::len);          // type properties use ::, not . (Status.len does not exist)
	int[Status::len] per_status;                   // a compile-time constant: usable as an array size
	per_status[Status.ACTIVE.ordinal] += 1;
	io::printfn("%d %d", per_status.len, per_status[1]);
	io::printn(Status::from_ordinal(1));           // back from the ordinal
	foreach (name : Status::names) io::printn(name);
}recipes/enum_count.c3recipeRecipe: enum with a method, enum with associated values, switch on an enumimport std::io;

enum Status { IDLE, ACTIVE, DONE }

fn bool Status.is_active(self) => self == ACTIVE;

enum Light : int (String action)           // associated value per constant
{
	RED { "stop" },
	GREEN { "go" },
}

fn void main()
{
	Status s = ACTIVE;
	io::printfn("%s is active: %s", s, s.is_active());

	Light l = GREEN;
	io::printfn("GREEN=%d name=%s", l.ordinal, l);
	switch (l)
	{
		case RED: io::printn(l.action);
		case GREEN: io::printn(l.action);   // no fallthrough, no break needed
	}
}recipes/enum_method.c3recipeRecipe: read an environment variable (env::tget_var, get_var, set_var)import std::io;
import std::os::env;

fn void main()
{
	env::set_var("RECIPE_X", "42");
	String? x = env::tget_var("RECIPE_X");      // temp allocator; get_var(allocator, name) for your own
	if (try x) io::printfn("RECIPE_X=%s", x);

	String? y = env::tget_var("RECIPE_Y");
	if (catch y) io::printn("RECIPE_Y is not set");
}recipes/env_var.c3recipeRecipe: faults and optionals (faultdef, int? return, return FAULT~, if catch, try, ??, rethrow with !, !! to panic)// Also: optional, result, error handling, null, ?? coalescing default value, rethrow, try catch, Result
import std::io;

faultdef NEGATIVE_INPUT;                  // 0.8: faultdef, not "fault Name { ... }"

fn int? check(int val)
{
	if (val < 0) return NEGATIVE_INPUT~;  // returning a fault: add ~
	return val;
}

fn int? twice(int val)
{
	int v = check(val)!;                  // ! passes the fault up to the caller
	return v * 2;
}

fn void main()
{
	int? r = check(-5);
	if (catch err = r) io::printfn("error: %s", err);

	if (try v = check(7)) io::printfn("ok: %d", v);

	io::printfn("default: %d", twice(-1) ?? 0);   // ?? gives a fallback when there is a fault
}recipes/faults.c3recipeRecipe: formatting and printing (printfn, %d %s %f %x %p, width, padding, string::format, DString)import std::io;

fn void main()
{
	io::printfn("n=%d hex=%x pi=%.2f [%4d] [%04d]", 42, 42, 3.14159, 7, 7);

	String s = string::format(mem, "hello, %d", 3);   // allocates: free it
	defer s.free(mem);
	io::printn(s);

	DString d = dstring::temp();                      // growable string builder
	d.append("a");
	d.append_char('b');
	d.appendf("%s", "c");
	io::printn(d.str_view());
}recipes/format.c3recipeRecipe: generic function and generic struct (module with {Type}, instantiate with {int})module recipe_generics <Type>;
import std::io;

struct Box
{
	Type value;
}

fn Type Box.get(self) => self.value;


module recipe_max <Type>;      // every function of a module is instantiated: keep max away from Box{String}

fn Type max(Type a, Type b) => a > b ? a : b;

module recipe_generics;
import std::io, recipe_max;

alias IntBox = recipe_generics::Box{int};
alias StrBox = recipe_generics::Box{String};

fn void main()
{
	IntBox a = { 7 };
	io::printn(a.get());
	io::printfn("max=%d", recipe_max::max{int}(4, 9));
	StrBox b = { "abc" };
	io::printfn("box=%s", b.get());
}recipes/generics.c3recipeRecipe: HashMap with String keys (init, set, get with default, has_key, iterate, free)// Also: dictionary, map, key value, HashMap{String, int}, count words, frequency, set, get
import std::io;
import std::collections::map;

fn void main()
{
	HashMap{String, int} counts;
	counts.init(mem);          // mem = heap; tmem = temp allocator
	defer counts.free();

	foreach (w : "the cat the dog the".tsplit(" "))
	{
		counts.set(w, (counts.get(w) ?? 0) + 1);    // get returns an optional: ?? gives a default
	}
	io::printfn("the=%d", counts.get("the") ?? 0);
	io::printfn("bird=%d", counts.get("bird") ?? 0);
	io::printfn("distinct: %d", counts.len());

	counts.@each(; String key, int value) { /* visit every pair; order is not defined */ };
}recipes/hashmap.c3recipeRecipe: HashSet (add, contains, remove, len): unique values, membership test// Also: set, unique, duplicates, dedupe, membership, contains, HashSet{int}
import std::io;
import std::collections::set;

fn void main()
{
	HashSet{int} seen;
	seen.init(mem);
	defer seen.free();
	foreach (v : (int[]){ 1, 2, 2, 3, 1 }) seen.add(v);
	io::printfn("distinct: %d", seen.len());
	io::printfn("has 2: %s", seen.contains(2));
	io::printfn("has 9: %s", seen.contains(9));
}recipes/hashset.c3recipeRecipe: optional interface method: @optional, test that an implementor has the method before calling it (if (&r.close)), calling a missing one panics// Also: interface, @dynamic, dynamic dispatch, not implemented, may not be implemented, method exists check
import std::io;

interface Reader
{
	fn String name();
	fn void close() @optional;       // an implementor may leave this out
}

struct File (Reader) { int fd; }
struct Memory (Reader) { int n; }

fn String File.name(&self) @dynamic => "file";
fn void File.close(&self) @dynamic { io::printn("file closed"); }
fn String Memory.name(&self) @dynamic => "memory";      // no close()

fn void finish(Reader r)
{
	io::printfn("finishing %s", r.name());
	if (&r.close)                    // test that the optional method exists; calling a missing one panics
	{
		r.close();
	}
	else
	{
		io::printn("(no close)");
	}
}

fn void main()
{
	File f = { 3 };
	Memory m = { 1 };
	finish(&f);
	finish(&m);
}recipes/interface_optional.c3recipeRecipe: parse JSON text into a tree and read values from it (std::encoding::json); reading a missing key gives an error// Also: json, parse json, JSON object, get_int, get_string, dynamic tree, decode
import std::io;
import std::encoding::json;
import std::collections::object;

fn void main()
{
	Object*? doc = json::parse(tmem, `{"name": "Ada", "age": 36}`);
	if (catch doc)
	{
		io::printn("bad json");
		return;
	}
	String? name = doc.get_string("name");
	if (try n = name) io::printfn("name=%s", n);
	int? age = doc.get_int("age");
	if (try a = age) io::printfn("age=%d", a);
	int? nope = doc.get_int("nope");
	if (catch nope) io::printn("no such key");
}recipes/json_parse.c3recipeRecipe: List (dynamic array): push, index, foreach, pop, remove, free// Also: List{int}, dynamic array, vector, ArrayList, push_back, append, remove
import std::io;
import std::collections::list;

fn void main()
{
	List{int} xs;
	xs.init(mem);
	defer xs.free();

	for (int i = 1; i <= 5; i++) xs.push(i);
	int sum;
	foreach (x : xs) sum += x;
	io::printfn("sum=%d len=%d", sum, xs.len());
	io::printfn("last=%d", xs[xs.len() - 1]);
	xs.pop()!!;
	io::printfn("after pop: %d", xs.len());
}recipes/list.c3recipeRecipe: loops: foreach with index, foreach over a slice of an array, for, while, break and continue (there is no range in foreach)// Also: range, for each, 0..n, iterate, enumerate, index, while, for loop
import std::io;

fn void main()
{
	String[] xs = { "a", "b" };
	foreach (i, x : xs) io::printf(i == 0 ? "%d:%s" : " %d:%s", i, x);
	io::printn("");

	for (int i = 1; i < 4; i++) io::printf(i == 1 ? "%d" : " %d", i);   // counting: use for
	io::printn("");

	int n;
	while (n < 10)
	{
		if (n == 3) break;
		io::printf(n == 0 ? "%d" : " %d", n);
		n++;
	}
	io::printn("");

	int[4] a = { 10, 20, 30, 40 };
	foreach (v : a[1..2]) io::printf(v == 20 ? "%d" : " %d", v);       // slice a[1..2] includes index 2
	io::printn("");
}recipes/loops.c3recipeRecipe: list a directory, only the files that match a mask (*.txt), sorted by name// Also: glob, filter files, extension, readdir, opendir, scandir, directory listing, file names
import std::io;
import std::io::path;
import std::sort;

fn int by_text(String a, String b) => a.compare_to(b);

fn void main()
{
	Path? dir = path::temp_directory(tmem);
	if (catch err = dir) return;
	Path? sub = dir.tappend("recipe_mask");
	if (catch err = sub) return;
	if (path::exists(sub)) path::rmtree(sub)!!;
	path::mkdir(sub, true)!!;
	defer (void)path::rmtree(sub);
	String base = (String)sub;
	file::save(string::tformat("%s/b.txt", base), "b")!!;
	file::save(string::tformat("%s/a.txt", base), "a")!!;
	file::save(string::tformat("%s/c.log", base), "c")!!;

	// path::ls(allocator, dir, no_dirs, no_symlinks, mask)
	PathList? entries = path::ls(tmem, sub, true, false, "*.txt");
	if (catch err = entries) return;
	String[] names = mem::talloc_array(String, entries.len());
	foreach (i, e : entries) names[i] = e.basename();
	sort::quicksort(names, &by_text);
	foreach (n : names) io::printn(n);
}recipes/ls_mask.c3recipeRecipe: macros with compile-time parameters: runtime::@enum_lookup(Type, "field", value), a macro with a trailing block (HashMap @each), @pool// Also: $Type, $name is a string, enum associated value lookup, find enum by field, macro from another module needs its module prefix, @each_entry, block parameters after ;
import std::io;
import std::collections::map;

enum Light : int (String action, int code)
{
	RED   { "stop", 1 },
	GREEN { "go", 2 },
}

fn void main()
{
	// @enum_lookup($Type, $name, value): $name is the NAME of an associated value, written as a string ("action"),
	// not as an identifier. A macro from another module is called with its module: runtime::@enum_lookup.
	Light? l = runtime::@enum_lookup(Light, "action", "go");
	if (try l) io::printfn("%s has code %d", l, l.code);
	Light? none = runtime::@enum_lookup(Light, "code", 99);
	if (catch none) io::printn("no such code");

	// A macro with a trailing block: the names after `;` are the block's parameters. HashMap.@each gives key and value
	// (Object.@each_entry gives key and value too, HashMap.@each_entry gives one Entry*).
	HashMap{String, int} ages;
	ages.tinit();
	ages.set("ada", 36);
	ages.@each(; String key, int value)
	{
		io::printfn("%s=%d", key, value);
	};

	// @pool(): temp allocations made inside are freed at the end of the block
	@pool()
	{
		String s = string::tformat("%d-%d", 1, 2);
		io::printn(s);
	};
}recipes/macro_params.c3recipeRecipe: macros: @macro name, #expr (unevaluated expression), $stringify, $Typeof (a type from an expression), generic parameter, compile-time $ifimport std::io;

macro @print_expr(#expr)
{
	io::printfn("%s = %s", $stringify(#expr), #expr);
}

macro twice(x) => x + x;                       // no # : x is evaluated once, any type

fn void main()
{
	@print_expr(1 + 2);
	io::printn(twice(2) + 1);
	$if $feat(NEVER_DEFINED):
		io::printn("not compiled");
	$endif
}recipes/macros.c3recipeRecipe: create a directory (mkdir), list a directory (ls), check that a path exists, delete a directory (rmtree)import std::io;
import std::io::path;

fn void main()
{
	Path? dir = path::temp_directory(tmem);
	if (catch err = dir) return;
	Path? sub = dir.tappend("recipe_dir");
	if (catch err = sub) return;
	if (path::exists(sub)) path::rmtree(sub)!!;

	path::mkdir(sub, true)!!;            // true: also create missing parents
	String base = (String)sub;           // a Path is a String underneath
	file::save(string::tformat("%s/a.txt", base), "a")!!;
	file::save(string::tformat("%s/b.txt", base), "b")!!;
	io::printfn("exists: %s", path::exists(sub));

	PathList? list = path::ls(tmem, sub);
	if (try l = list) io::printfn("entries: %d", l.len());

	path::rmtree(sub)!!;
	io::printfn("gone: %s", !path::exists(sub));
}recipes/mkdir_ls.c3recipeRecipe: parse a string to an integer or a float; a failed parse is a fault, not a crashimport std::io;

fn void main()
{
	int? v = "1234".to_int();
	if (try x = v) io::printfn("value=%d", x);

	int? bad = "12x".to_int();
	if (catch bad) io::printn("invalid");

	double? d = "3.14".to_double();
	if (try y = d) io::printfn("pi=%.2f", y);
}recipes/parse_int.c3recipeRecipe: random numbers (random::rand, seeded generator)import std::io;
import std::math::random;

fn void main()
{
	int n = random::rand(10);                  // 0..9
	io::printfn("in range: %s", n >= 0 && n < 10);

	Sfc64Random a, b;
	random::seed(&a, 42);                      // the same seed gives the same sequence
	random::seed(&b, 42);
	io::printfn("same sequence: %s", a.next_int() == b.next_int());
}recipes/random.c3recipeRecipe: read a file line by line (open, readline, close)import std::io;

fn void main()
{
	file::save("recipe_lines.txt", "ab\nlonger\nxyz\n")!!;
	defer (void)file::delete("recipe_lines.txt");

	File? f = file::open("recipe_lines.txt", "r");
	if (catch err = f)
	{
		io::printfn("cannot open: %s", err);
		return;
	}
	defer (void)f.close();

	int n;
	String longest;
	// readline returns the next line without the newline, and the fault io::EOF at the end
	while (try line = io::treadline(&f))
	{
		n++;
		if (line.len > longest.len) longest = line.tcopy();
	}
	io::printfn("lines: %d", n);
	io::printfn("longest: %s", longest);
}recipes/read_lines.c3recipeRecipe: run an external command and capture its output (process::run_capture_stdout)import std::io;
import std::os::process;

fn void main()
{
	char[256] buffer;
	String? out = process::run_capture_stdout(buffer[..], { "echo", "hi" });
	if (catch err = out)
	{
		io::printfn("failed: %s", err);
		return;
	}
	io::printn(out.trim());
}recipes/run_command.c3recipeRecipe: sort an array or a List with a comparison function (std::sort quicksort, insertion_sort)// Also: quicksort, insertion_sort, comparator, cmp, order by field, sort struct array, sort by key, qsort
import std::io;
import std::sort;

fn int desc(int a, int b) => b - a;      // negative: a comes first

fn void main()
{
	int[4] a = { 5, 1, 9, 3 };
	sort::quicksort(a[..], &desc);
	foreach (i, v : a) io::printf(i == 0 ? "%d" : " %d", v);
	io::printn("");

	// without a comparison function, the elements' own order is used
	sort::quicksort(a[..]);
	foreach (i, v : a) io::printf(i == 0 ? "%d" : " %d", v);
	io::printn("");
}recipes/sort.c3recipeRecipe: sort structs by a field, sort strings, and list a HashMap's keys in sorted order// Also: order by key, sort by age, compare_to, keys(), alphabetical, string compare, qsort
import std::io;
import std::sort;
import std::collections::map;

struct Person
{
	String name;
	int age;
}

fn int by_age(Person a, Person b) => a.age - b.age;
fn int by_text(String a, String b) => a.compare_to(b);     // String cannot be ordered with < >: use compare_to

fn void main()
{
	Person[2] people = { { "Ann", 31 }, { "Bob", 25 } };
	sort::quicksort(people[..], &by_age);
	foreach (p : people) io::printfn("%s %d", p.name, p.age);

	HashMap{String, int} m;
	m.init(mem);
	defer m.free();
	m.set("c", 3);
	m.set("a", 1);
	m.set("b", 2);
	String[] keys = m.keys(tmem);          // iteration order of a map is not defined: sort the keys
	sort::quicksort(keys, &by_text);
	foreach (i, k : keys) io::printf(i == 0 ? "%s" : " %s", k);
	io::printn("");
}recipes/sort_structs.c3recipeRecipe: read lines from standard input until the end (treadline returns a fault at EOF)// Also: stdin, scanf, gets, getline, input, read line from console, interactive, pipe
import std::io;

fn void main()
{
	int n;
	while (try line = io::treadline())      // io::EOF ends the loop
	{
		n++;
		io::printfn("%d: %s", n, line);
	}
}recipes/stdin_lines.c3recipeRecipe: strings: split, join, trim, upper case, contains, starts_with, replace, parse (temp-allocator versions end in t)import std::io;

fn void main()
{
	String[] parts = "a,b,c".tsplit(",");
	io::printn(string::tjoin(parts, "-"));
	io::printfn("[%s]", "   hi there  ".trim());
	io::printn("hello".to_upper_tcopy());
	io::printfn("%s %s", "hello world".contains("o w"), "hello".starts_with("he"));
	io::printn("a,b,c".treplace(",", "_"));
}recipes/strings.c3recipeRecipe: struct with methods (fn Type.method), construction, interface implementation// Also: class, object, member function, impl, trait, interface, vtable, struct{} methods
import std::io;

struct Rect (Describe)
{
	int w, h;
}

fn int Rect.area(self) => self.w * self.h;
fn void Rect.scale(&self, int f) { self.w *= f; self.h *= f; }   // &self: modifies the original

interface Describe
{
	fn String describe();
}

fn String Rect.describe(&self) @dynamic => string::tformat("Rect %dx%d", self.w, self.h);

fn void main()
{
	Rect r = { .w = 3, .h = 4 };
	io::printfn("area=%d", r.area());

	Describe d = &r;                       // interface value from a pointer
	io::printn(d.describe());
}recipes/struct_method.c3recipeRecipe: tcp server and client: tcp::listen, accept, connect, read and write a message over a socket (std::net)// Also: socket, listen, accept, connect, tcp server, tcp client, network, port, localhost, echo, send, recv, TcpSocket, TcpServerSocket
import std::io;
import std::net;

fn void? run()
{
	// port 0: the system picks a free port; the connection waits in the backlog until accept
	TcpServerSocket server = tcp::listen("127.0.0.1", 0, 4, REUSEADDR)!;
	defer (void)server.close();
	ushort port = server.local_port()!;

	TcpSocket client = tcp::connect("127.0.0.1", port)!;
	defer (void)client.close();
	TcpSocket conn = tcp::accept(&server)!;   // takes a pointer to the server socket
	defer (void)conn.close();

	client.write("hello")!;                    // a TcpSocket has the methods of Socket: read, write, close...
	char[16] buf;
	sz n = conn.read(&buf)!;
	io::printfn("server got: %s", (String)buf[:n]);

	conn.write("HELLO")!;
	n = client.read(&buf)!;
	io::printfn("client got: %s", (String)buf[:n]);
}

fn void main()
{
	if (catch err = run()) io::printfn("failed: %s", err);
}recipes/tcp_echo.c3recipeRecipe: a unit test (@test function with assert; run with c3_test / `c3c test`, not part of the program)// Also: testing, unit test, assert, @test, test function, expect
import std::io;

fn int add(int a, int b) => a + b;

fn void add_works() @test
{
	assert(add(2, 2) == 4, "2 + 2 should be 4");
	assert(add(-1, 1) == 0);
}

fn void main()
{
	io::printfn("add(2, 2)=%d", add(2, 2));
}recipes/test_function.c3recipeRecipe: threads: Thread.create, join, Mutex lock/unlock// Also: pthread, concurrency, parallel, mutex lock, race, join, spawn, Thread.create
import std::io;
import std::thread;

Mutex lock;
int counter;

fn int work(void* arg)
{
	for (int i = 0; i < 1000; i++)
	{
		lock.lock()!!;
		counter++;
		lock.unlock();
	}
	return 0;
}

fn void main()
{
	lock.init()!!;
	defer (void)lock.destroy();
	Thread a, b;
	a.create(&work, null)!!;
	b.create(&work, null)!!;
	a.join()!!;
	b.join()!!;
	io::printfn("counter=%d", counter);
}recipes/threads.c3recipeRecipe: time: measure elapsed time (clock::now, mark), sleep (thread::sleep, ms)import std::io;
import std::time;
import std::thread;

fn void main()
{
	Clock start = clock::now();
	thread::sleep(time::ms(50))!!;
	NanoDuration elapsed = start.to_now();
	io::printfn("slept at least 50ms: %s", elapsed.to_ms() >= 50);
}recipes/time_sleep.c3recipeRecipe: write a string to a file and read a whole file back (file::save, file::load_temp)import std::io;

fn void main()
{
	String path = "recipe_rw.txt";
	if (catch err = file::save(path, "hello file"))
	{
		io::printfn("write failed: %s", err);
		return;
	}
	defer (void)file::delete(path);

	char[]? data = file::load_temp(path);   // temp allocator: no free needed
	if (catch err = data) return;
	io::printn((String)data);
}recipes/write_read_file.c3macrocompiler_rt::@__atomic_compare_exchange_ordering_failuremacro @__atomic_compare_exchange_ordering_failure(ptr, expected, desired, AtomicOrderingRT $success, AtomicOrderingRT failure, $alignment)lib/std/_compiler_rt/atomic_rt.c3:255:7macrocompiler_rt::@__atomic_compare_exchange_ordering_successmacro @__atomic_compare_exchange_ordering_success(ptr, expected, desired, success, AtomicOrderingRT failure, $alignment)lib/std/_compiler_rt/atomic_rt.c3:267:7macrocompiler_rt::@__atomic_exchange_dispatchmacro @__atomic_exchange_dispatch(ptr, value, ordering, $alignment)lib/std/_compiler_rt/atomic_rt.c3:241:7macrocompiler_rt::@__atomic_exchange_orderingmacro @__atomic_exchange_ordering(ptr, value, AtomicOrderingRT $ordering, $alignment)lib/std/_compiler_rt/atomic_rt.c3:236:7macrocompiler_rt::@__atomic_load_dispatchmacro @__atomic_load_dispatch(ptr, ordering, $alignment)lib/std/_compiler_rt/atomic_rt.c3:188:7macrocompiler_rt::@__atomic_store_dispatchmacro @__atomic_store_dispatch(ptr, value, ordering, $alignment)lib/std/_compiler_rt/atomic_rt.c3:200:7macrocompiler_rt::@__udivmodti4macro uint128 @__udivmodti4(uint128 a, uint128 b, bool $return_rem)lib/std/_compiler_rt/i128_rt.c3:24:15typecompiler_rt::AtomicOrderingRTconstset AtomicOrderingRT { AtomicOrderingRT NOT_ATOMIC, AtomicOrderingRT UNORDERED, AtomicOrderingRT RELAXED, AtomicOrderingRT ACQUIRE, AtomicOrderingRT RELEASE, AtomicOrderingRT ACQUIRE_RELEASE, AtomicOrderingRT SEQ_CONSISTENT }
