The SimpleHeapAllocator implements a simple heap allocator on top of an allocator function. It uses the given allocator function to allocate memory from some source, but never frees it. This allocator is intended to be used in environments where there isn't any native libc malloc, and it has to be emulated from a memory region, or wrapping linear memory as is the case for plain WASM.lib/std/core/allocators/heap_allocator.c3:15:8methodstd::core::mem::allocators::SimpleHeapAllocator.acquirefn void*? acquire(&SimpleHeapAllocator* self, sz size, AllocInitType init_type, sz alignment)lib/std/core/allocators/heap_allocator.c3:31:31methodstd::core::mem::allocators::SimpleHeapAllocator.initfn void init(&SimpleHeapAllocator* self, MemoryAllocFn allocator)lib/std/core/allocators/heap_allocator.c3:25:29methodstd::core::mem::allocators::SimpleHeapAllocator.releasefn void release(&SimpleHeapAllocator* self, void* old_pointer, bool aligned)lib/std/core/allocators/heap_allocator.c3:47:29methodstd::core::mem::allocators::SimpleHeapAllocator.resizefn void*? resize(&SimpleHeapAllocator* self, void* old_pointer, sz size, sz alignment)lib/std/core/allocators/heap_allocator.c3:40:31typestd::core::mem::allocators::TempAllocatorstruct TempAllocator (Allocator) { Allocator backing_allocator, TempAllocatorPage* last_page, TempAllocator* derived, bool allocated, sz reserve_size, sz realloc_size, sz min_size, sz used, sz capacity, sz original_capacity, char[*] data }lib/std/core/allocators/temp_allocator.c3:31:8methodstd::core::mem::allocators::TempAllocator.acquirefn void*? acquire(&TempAllocator* self, sz size, AllocInitType init_type, sz alignment)lib/std/core/allocators/temp_allocator.c3:231:25methodstd::core::mem::allocators::TempAllocator.derive_allocatorfn TempAllocator*? derive_allocator(&TempAllocator* self, sz reserve = 0)lib/std/core/allocators/temp_allocator.c3:89:34methodstd::core::mem::allocators::TempAllocator.freefn void free(&TempAllocator* sel