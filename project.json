{
  "langrev": "1",
  "warnings": ["no-unused"],
  "authors": ["Koni Marti <koni.marti@gmail.com>"],
  "version": "0.5.0",
  "sources": ["src/**"],
  "test-sources": ["test/**"],
  "dependency-search-paths": ["deps"],
  "dependencies": [ "mcp" ],
  "c-sources": [
    "vendor/tree-sitter/src/lib.c",
    "vendor/tree-sitter-c3/src/parser.c",
    "vendor/tree-sitter-c3/src/scanner.c"
  ],
  "c-include-dirs": [ "vendor/tree-sitter/src", "vendor/tree-sitter/include", "vendor/tree-sitter-c3/src" ],
  "cflags": "-O2 -D_POSIX_C_SOURCE=200112L -D_DEFAULT_SOURCE",
  "build-dir": "build",
  "output": "build",
  "targets": {
    "c3-guide-mcp": { "type": "executable" }
  }
}
